# -*- mode: Perl -*-
# Minimal structural binding for the Japanese jsarticle class.
# Page layout and pLaTeX-specific typography belong to the PDF; the HTML
# conversion reuses LaTeXML's semantic article structure.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

LoadClass('article');

# pLaTeX's Gothic-family text command has no direct HTML distinction in
# LaTeXML. Preserve its emphasis rather than leaving an error marker.
DefMacro('\textgt{}', '\textbf{#1}');

1;
